<Window x:Class="GameLock.Gui.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameLock" Height="180" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptLabel" Text="Enter password:" Margin="0,0,0,8"/>
        <PasswordBox x:Name="PasswordBox1" Margin="0,0,0,8"/>
        <TextBlock x:Name="PromptLabel2" Text="" Margin="0,0,0,8" Visibility="Collapsed"/>
        <PasswordBox x:Name="PasswordBox2" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
